.version 7.5
.target sm_87
.address_size 64

// Orin Nano Super: one CUDA block per output row, 128 threads.
.visible .entry nf4_gemv(
    .param .u64 packed,
    .param .u64 scales,
    .param .u64 x,
    .param .u64 y,
    .param .u64 code,
    .param .u32 rows,
    .param .u32 cols
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<48>;
    .reg .b64 %rd<40>;
    .reg .f32 %f<24>;
    .shared .align 4 .b32 shc[16];
    .shared .align 4 .b32 shp[128];

    ld.param.u64 %rd0, [packed];
    ld.param.u64 %rd1, [scales];
    ld.param.u64 %rd2, [x];
    ld.param.u64 %rd3, [y];
    ld.param.u64 %rd4, [code];
    ld.param.u32 %r0, [rows];
    ld.param.u32 %r1, [cols];

    mov.u32 %r2, %ctaid.x;
    setp.ge.u32 %p0, %r2, %r0;
    @%p0 bra DONE;

    mov.u32 %r3, %tid.x;

    // codebook -> shared via u64 address (Orin JIT rejects [shc+%r])
    setp.ge.u32 %p1, %r3, 16;
    @%p1 bra AFTER_CODE;
    mul.lo.u32 %r4, %r3, 4;
    cvt.u64.u32 %rd5, %r4;
    add.s64 %rd6, %rd4, %rd5;
    ld.global.f32 %f0, [%rd6];
    mov.u64 %rd7, shc;
    add.u64 %rd8, %rd7, %rd5;
    st.shared.f32 [%rd8], %f0;
AFTER_CODE:
    bar.sync 0;

    shr.u32 %r5, %r1, 1;
    mul.lo.u32 %r6, %r2, %r5;
    cvt.u64.u32 %rd9, %r6;
    add.s64 %rd10, %rd0, %rd9;

    shr.u32 %r7, %r1, 6;
    mul.lo.u32 %r8, %r2, %r7;
    mul.wide.u32 %rd11, %r8, 4;
    add.s64 %rd12, %rd1, %rd11;

    mov.f32 %f1, 0f00000000;
    mov.u32 %r9, %r3;

BLK_LOOP:
    setp.ge.u32 %p0, %r9, %r7;
    @%p0 bra REDUCE;

    mul.wide.u32 %rd13, %r9, 4;
    add.s64 %rd14, %rd12, %rd13;
    ld.global.f32 %f2, [%rd14];

    mul.lo.u32 %r10, %r9, 32;
    cvt.u64.u32 %rd15, %r10;
    add.s64 %rd16, %rd10, %rd15;

    mul.lo.u32 %r11, %r9, 64;
    mov.u32 %r12, 0;

INNER:
    setp.ge.u32 %p0, %r12, 32;
    @%p0 bra NEXT;

    cvt.u64.u32 %rd17, %r12;
    add.s64 %rd18, %rd16, %rd17;
    ld.global.u8 %r13, [%rd18];
    shr.u32 %r14, %r13, 4;
    and.b32 %r15, %r13, 15;

    mul.lo.u32 %r16, %r14, 4;
    cvt.u64.u32 %rd19, %r16;
    mov.u64 %rd20, shc;
    add.u64 %rd21, %rd20, %rd19;
    ld.shared.f32 %f3, [%rd21];
    mul.f32 %f4, %f3, %f2;

    mul.lo.u32 %r17, %r15, 4;
    cvt.u64.u32 %rd22, %r17;
    add.u64 %rd23, %rd20, %rd22;
    ld.shared.f32 %f5, [%rd23];
    mul.f32 %f6, %f5, %f2;

    mul.lo.u32 %r18, %r12, 2;
    add.u32 %r19, %r11, %r18;
    mul.wide.u32 %rd24, %r19, 4;
    add.s64 %rd25, %rd2, %rd24;
    ld.global.f32 %f7, [%rd25];

    add.u32 %r20, %r19, 1;
    mul.wide.u32 %rd26, %r20, 4;
    add.s64 %rd27, %rd2, %rd26;
    ld.global.f32 %f8, [%rd27];

    mad.rn.f32 %f1, %f4, %f7, %f1;
    mad.rn.f32 %f1, %f6, %f8, %f1;

    add.u32 %r12, %r12, 1;
    bra INNER;

NEXT:
    add.u32 %r9, %r9, 128;
    bra BLK_LOOP;

REDUCE:
    mul.lo.u32 %r21, %r3, 4;
    cvt.u64.u32 %rd28, %r21;
    mov.u64 %rd29, shp;
    add.u64 %rd30, %rd29, %rd28;
    st.shared.f32 [%rd30], %f1;
    bar.sync 0;
    setp.ne.u32 %p0, %r3, 0;
    @%p0 bra DONE;

    mov.f32 %f9, 0f00000000;
    mov.u32 %r22, 0;
SUM:
    setp.ge.u32 %p0, %r22, 128;
    @%p0 bra STORE;
    mul.lo.u32 %r23, %r22, 4;
    cvt.u64.u32 %rd31, %r23;
    add.u64 %rd32, %rd29, %rd31;
    ld.shared.f32 %f10, [%rd32];
    add.f32 %f9, %f9, %f10;
    add.u32 %r22, %r22, 1;
    bra SUM;

STORE:
    mul.wide.u32 %rd33, %r2, 4;
    add.s64 %rd34, %rd3, %rd33;
    st.global.f32 [%rd34], %f9;

DONE:
    ret;
}
